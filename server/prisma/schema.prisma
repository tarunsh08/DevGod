generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  role         String    @default("user")
  passwordHash String?
  comments     Comment[]
  likes        Like[]
}

model Developer {
  id           String    @id @default(uuid())
  name         String
  email        String?   @unique
  bio          String?
  skills       String[]
  socialLinks  Json?
  passwordHash String?   // Added for local authentication
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  comments     Comment[]
  likes        Like[]
  projects     Project[]
}

model Project {
  id          String    @id @default(uuid())
  developerId String
  title       String
  description String
  useCase     String
  howToUse    String
  techStack   String[]
  category    String
  demoLink    String
  repoLink    String
  images      String[]
  likesCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  comments    Comment[]
  likes       Like[]
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@index([developerId])
  @@index([createdAt])
}

model Like {
  id          String     @id @default(uuid())
  projectId   String
  userId      String?
  developerId String?
  createdAt   DateTime   @default(now())
  developer   Developer? @relation(fields: [developerId], references: [id], onDelete: Cascade)
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@unique([projectId, developerId])
  @@index([projectId])
  @@index([userId])
  @@index([developerId])
}

model Comment {
  id          String     @id @default(uuid())
  projectId   String
  userId      String?
  developerId String?
  content     String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  developer   Developer? @relation(fields: [developerId], references: [id], onDelete: Cascade)
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([developerId])
}
